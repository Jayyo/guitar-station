#!/usr/bin/env python3
"""Command-line control for guitar-station: status, on, off, devices, level, tune."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for root in (os.path.join(here, "..", "share", "guitar-station"), os.path.join(here, "..")):
    if os.path.isdir(os.path.join(root, "guitarstation")):
        sys.path.insert(0, os.path.abspath(root))
        break

from guitarstation.cli import main  # noqa: E402

sys.exit(main())
